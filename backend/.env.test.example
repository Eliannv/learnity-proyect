# Copia este archivo como .env.test para ejecutar "npm test". El .env.test NUNCA se sube a GitHub.
# Usa una base SOLO para pruebas (por ejemplo learnity_test, creada igual que la de desarrollo:
# learnity_esquema.sql + 015_sesiones_y_recuperacion.sql + 016_limpieza_pdf.sql). Las pruebas crean y borran cuentas @pruebas.test.
NODE_ENV=test
DB_HOST=localhost
DB_PORT=5432
DB_NAME=learnity_test
DB_USER=learnity_app
DB_PASSWORD=CAMBIA_ESTA_CLAVE_APP
DB_SSL=false
JWT_SECRET=una-cadena-de-pruebas-de-al-menos-32-caracteres
CORS_ORIGIN=http://localhost:4200
FRONTEND_URL=http://localhost:4200
COOKIE_SECURE=false
# Las pruebas usan el buzón local (carpeta temporal); no envían correos reales.
CORREO_TRANSPORTE=buzon
# PDF de las pruebas, separados de los de desarrollo.
PDF_DIR=uploads/pdf-test
