# Copia este archivo como .env y completa los valores. El .env NUNCA se sube a GitHub.

# Servidor
PORT=3000
NODE_ENV=development
# Origen del frontend de Angular (CORS y verificación de origen). Varios: separados por comas.
CORS_ORIGIN=http://localhost:4200
# URL pública del frontend: con ella se arma el enlace de recuperación del correo.
FRONTEND_URL=http://localhost:4200
# false = conexión directa. Detrás de un proxy inverso (Nginx) usa 1 para leer la IP real del cliente.
TRUST_PROXY=false

# Base de datos PostgreSQL (cuenta del backend: learnity_app, solo lee y modifica datos)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=learnity
DB_USER=learnity_app
DB_PASSWORD=CAMBIA_ESTA_CLAVE_APP
# En el PostgreSQL local de desarrollo, mantener false.
DB_SSL=false

# Sesiones. JWT_SECRET: cadena aleatoria de 32+ caracteres. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esta-cadena-por-una-larga-y-aleatoria-de-32+
# Access token (JWT en memoria del navegador), en minutos.
ACCESS_MINUTOS=15
# Refresh token (cookie HttpOnly): vence tras estos días sin uso; la sesión dura como máximo SESION_MAX_DIAS.
REFRESH_DIAS=7
SESION_MAX_DIAS=30
# Cookies solo por HTTPS. En desarrollo local por HTTP: false. En producción es obligatorio true.
COOKIE_SECURE=false

# Recuperación de contraseña: vigencia del enlace (15 a 30 minutos).
RECUPERACION_MINUTOS=20
# Comprobar contraseñas expuestas con Have I Been Pwned (solo viajan 5 caracteres del hash SHA-1).
HIBP_ACTIVO=true

# Correo. buzon = guarda los mensajes como archivos en BUZON_DIR (desarrollo, sin enviar nada).
#         gmail = envía con la Gmail API (ver README, sección "Correo con la Gmail API").
CORREO_TRANSPORTE=buzon
BUZON_DIR=.buzon
# Cliente OAuth de Google Cloud (tipo "App de escritorio") y cuenta que envía los correos.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REMITENTE=
GMAIL_NOMBRE_REMITENTE=Learnity
# Lo escribe "npm run correo:autorizar". No lo copies a mano ni lo compartas.
GMAIL_REFRESH_TOKEN=

# Contraseña de las cuentas de prueba que crea "npm run db:seed" (15+ caracteres, como exige la política).
SEED_PASSWORD=CAMBIA-por-una-frase-de-prueba-larga

# Carpeta donde se guardan los PDF de las lecciones (fuera de la carpeta pública; ignorada por Git).
PDF_DIR=uploads/pdf
