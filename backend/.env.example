# Copia este archivo como .env y completa los valores. El .env NUNCA se sube a GitHub.

# Servidor
PORT=3000
NODE_ENV=development
# Origen del frontend de Angular (para CORS)
CORS_ORIGIN=http://localhost:4200

# Base de datos PostgreSQL (cuenta del backend: learnity_app, solo lee y modifica datos)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=learnity
DB_USER=learnity_app
DB_PASSWORD=CAMBIA_ESTA_CLAVE_APP
# true solo si la base exige SSL (por ejemplo, Supabase)
DB_SSL=false

# Sesiones (JWT). Usa una cadena larga y aleatoria.
JWT_SECRET=cambia-esta-cadena-por-una-larga-y-aleatoria
JWT_EXPIRES_IN=8h

# Contraseña de las cuentas de prueba que crea "npm run db:seed"
SEED_PASSWORD=Learnity2026!
